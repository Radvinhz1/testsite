DJANGO_DEBUG=true
# Generate a unique value before deployment; keep .env out of Git.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_ENGINE=mysql
DB_NAME=testsite
DB_USER=testsite
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# To preview locally without MySQL only: set DB_ENGINE=sqlite
