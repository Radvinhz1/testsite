DJANGO_DEBUG=true
# Generate a unique value before deployment; keep .env out of Git.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_ENGINE=mssql
DB_NAME=testsite
# SQL Authentication: enter your dedicated login and password.
# Windows Authentication: leave DB_USER and DB_PASSWORD empty.
DB_USER=
DB_PASSWORD=
# Named instance example: DB_HOST=localhost\SQLEXPRESS and DB_PORT=
DB_HOST=localhost
DB_PORT=
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# true is for a LOCAL development server with a self-signed certificate only.
# In production set false and install a trusted server certificate.
DB_TRUST_SERVER_CERTIFICATE=true
# Optional preview without SQL Server: DB_ENGINE=sqlite
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=
# TRUST_PROXY_HTTPS=true

# Final public HTTPS domain, without a trailing path. Keep indexing off locally.
SITE_URL=
SEO_INDEXING_ENABLED=false
